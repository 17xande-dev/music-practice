# Plain-HTTP local development only. For LAN access, replace localhost with the LAN host.
COOKIE_SECURE=0
BASE_URL=http://localhost:8080
DB_PATH=data/dev.db
# Session limits are positive Go durations (24h = one day); idle must not exceed absolute.
SESSION_IDLE=720h
SESSION_ABSOLUTE=2160h
DEVICE_SESSION_IDLE=2160h
DEVICE_SESSION_ABSOLUTE=8760h
# Listen address, HSTS (true only behind HTTPS), shutdown wait and the trusted proxy header; all unset by default.
# ADDR=:8080
# HSTS=false
# SHUTDOWN_TIMEOUT=10s
# CLIENT_IP_HEADER=
