{
  // The frontend: TypeScript under frontend/, bundled by Deno into
  // internal/handler/static/dist/, which the Go binary embeds. The pages
  // themselves are Go templates, so only the TS entry points are bundled
  // (not HTML, as in teleprompter) and without --code-splitting, so their
  // output names stay fixed: dist/practice.js, dist/songs.js (with the score
  // renderer, so the scales page doesn't load it), dist/progress.js, and
  // dist/pitch_worklet.js (the guitar pitch tracker, loaded by URL into an
  // AudioWorklet, so it must be a file of its own). Go's
  // {{asset}} adds the content hash to the URL, so no hashed filenames are
  // needed and old bundles never accumulate in the embed.
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext", "deno.ns"],
    "strict": true
  },
  "include": ["frontend"],
  "fmt": {
    "lineWidth": 100,
    "include": ["frontend", "deno.jsonc"],
    // Generated by `deno task score-fixtures`.
    "exclude": ["frontend/lib/testdata/fixtures"]
  },
  "lint": {
    "include": ["frontend"]
  },
  "tasks": {
    // Cleans first, so a renamed entry never leaves its old output to be
    // embedded. The glob skips dotfiles, so dist/.gitkeep survives.
    "bundle": "deno task clean && deno bundle frontend/practice.ts frontend/songs.ts frontend/progress.ts frontend/pitch_worklet.ts frontend/sw.ts frontend/theme.ts --platform browser --minify --sourcemap=linked --outdir internal/handler/static/dist",
    "bundle-watch": "deno bundle --watch frontend/practice.ts frontend/songs.ts frontend/progress.ts frontend/pitch_worklet.ts frontend/sw.ts frontend/theme.ts --platform browser --sourcemap=linked --outdir internal/handler/static/dist",
    "clean": "rm -rf internal/handler/static/dist/*",
    "check": "deno check frontend",
    // --no-check: types are covered by `deno task check`.
    // Read access for the test that checks the README against the pages.
    "test": "deno test --no-check --allow-read=. frontend",
    // Parity fixtures for the Swift port: runs OSMD headless (jsdom) over the
    // starter songs and frontend/lib/testdata/edge, and writes
    // frontend/lib/testdata/fixtures/. See the README there.
    "score-fixtures": "deno run --allow-read --allow-write=frontend/lib/testdata/fixtures tools/score_fixtures.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    // Staff notation. Pinned exactly: rendering depends on its layout
    // internals, and a minor bump could move every glyph. Imported through
    // its "bravura" entry, which embeds the Bravura and Academico fonts as
    // data: URIs (hence the CSP's font-src data:); the default "core" path
    // would fetch them from a CDN at runtime.
    "vexflow": "npm:vexflow@5.0.0",
    // Song scores: renders MusicXML (and zipped .mxl) and walks it with a
    // cursor. BSD-3. Pinned exactly like VexFlow, for the same reason; it
    // carries its own VexFlow 1.x fork, used only on the songs page.
    "opensheetmusicdisplay": "npm:opensheetmusicdisplay@2.1.3"
  }
}
